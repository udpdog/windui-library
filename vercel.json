{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/script.js": { "includeFiles": "scripts/WindUI.lua" }
  },
  "routes": [
    { "src": "^/(?:WindUI\\.lua|api/script)/?$", "dest": "/api/script" },
    { "src": "^/.*$", "dest": "/api/not-found" }
  ]
}
